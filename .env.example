# Copy to .env and fill in.
DATABASE_URL="file:../data/dev.db"

# "google" = official Generative Language API (AI Studio key below).
# "test"   = deterministic offline provider for the automated test suite.
LLM_PROVIDER=test
GEMMA_MODEL=gemma-4-31b-it
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
UPLOAD_DIR=./data/uploads
PORT=8792
